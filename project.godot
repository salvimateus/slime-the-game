; Engine configuration file.

config_version=5

[application]

config/name="Slime Prototype"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.055, 0.063, 0.102, 1)
config/quit_on_go_back=false

[autoload]

Tuning="*res://autoload/tuning.gd"
Quality="*res://autoload/quality.gd"
Game="*res://autoload/game.gd"
Sfx="*res://autoload/sfx.gd"
Juice="*res://autoload/juice.gd"
Harness="*res://autoload/harness.gd"
TouchControls="*res://autoload/touch_controls.gd"
PerfPanel="*res://autoload/perf_panel.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=false

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="pieces"
2d_physics/layer_4="hazards"
2d_physics/layer_5="triggers"
2d_physics/layer_6="platforms"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.055, 0.063, 0.102, 1)
